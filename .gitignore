# graphify knowledge-graph output. Generated artefacts + extraction cache —
# rebuildable with `/graphify .`, and the cache alone runs to hundreds of
# files. Regenerate rather than version it.
graphify-out/

# Service-account credentials. Never commit these — GitHub push protection
# caught one that `git add -A` swept in from the repo root. Keep the file on
# disk and point GOOGLE_APPLICATION_CREDENTIALS at it from .env.local.
firebase-admin.json
*-service-account*.json
**/serviceAccountKey*.json

# Local .env backups (may contain secrets)
.env.bak-*

# Local scratch — never committed
/graphify-out/
/new-docs/
/Murchid/

# One package manager. Two lockfiles disagree silently, and the one that
# is not maintained goes stale the first time a dependency changes —
# pnpm-lock still listed express weeks after it was removed.
pnpm-lock.yaml
yarn.lock
bun.lockb
