# Copy this file to .env for local dev. .env is gitignored.

# ---- Backend (Render in prod, also used by `npm run dev` middleware) -------

# Neon Postgres connection string. Used by:
#   - backend/lib/db.js   — every API route
#   - backend/db/init.js  — schema + seed (`npm run db:init`)
# Get one from https://console.neon.tech (free tier is enough).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Express port for `npm run start:backend`. Render sets this automatically;
# leave it at 3001 (or unset) for local dev.
PORT=3001

# Redis. Optional in dev, REQUIRED before running more than one backend
# instance. Two things degrade without it, and both degrade quietly:
#   - rate limits fall back to per-process counters, so N instances hand out
#     N× the budget and every deploy resets them
#   - cache invalidation stops crossing instances, so a suspension, role change
#     or single-device sign-out can take up to ACCOUNT_CACHE_TTL_SECONDS to be
#     seen by the instances that didn't serve the write
# Any Redis works — Render Key Value, Upstash, or a local `docker run redis`.
# REDIS_URL=redis://localhost:6379

# How long requireAuth() may reuse a cached account row, in seconds.
# This is the worst-case delay on a revocation (suspend, role change, expiry,
# single-device eviction) if the invalidation that normally fires is missed or
# happens on another instance. Default 10. Set to 0 to disable the cache and
# read the row from Postgres on every request.
# ACCOUNT_CACHE_TTL_SECONDS=10

# Comma-separated list of allowed frontend origins for CORS. Leave empty to
# allow all origins (fine for dev; lock down on Render in prod).
# ALLOWED_ORIGINS=https://teachingassistant.vercel.app,https://my-domain.com

# Anthropic API key for the AI Studio generation endpoint. Optional — Studio
# is gated by the `ai_studio` feature flag (off by default), so leave this
# empty unless you've turned that flag on in the Dev console.
# Get one from https://console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Frontend (Vercel) -----------------------------------------------------

# Where the studio's /api calls go. Leave empty in dev so requests hit the
# same origin (Vite middleware). In Vercel project settings, set this to the
# Render URL (e.g. https://murchid-api.onrender.com) — without a trailing slash.

# VITE_API_URL=https://murchid-api.onrender.com
