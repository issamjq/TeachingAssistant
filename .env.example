# Copy this file to .env for local dev. .env is gitignored.
#
# `npm run dev` starts BOTH processes (concurrently):
#   - the Express API  (backend/index.js, port 3001) — reads the vars below
#   - the Next.js app  (next dev, port 3000)         — reads NEXT_PUBLIC_* only
# Next rewrites /api/* to the Express port, so the browser stays same-origin.

# ---- Backend (Render in prod, Express locally) -----------------------------

# Neon Postgres connection string. Used by:
#   - backend/lib/db.js   — every API route
#   - backend/db/init.js  — schema + seed (`npm run db:init`)
# Get one from https://console.neon.tech (free tier is enough).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Express port. Render sets this automatically; leave it at 3001 for local dev.
PORT=3001

# Where Next's /api/* rewrite proxies to in dev. Deliberately NOT derived from
# PORT: Next overwrites PORT with the port IT listens on, which turned the
# rewrite into a proxy loop back to the Next server. Only change this if the
# API runs somewhere other than localhost:3001.
API_PORT=3001

# Comma-separated list of allowed frontend origins for CORS. Leave empty to
# allow all origins (fine for dev; lock down on Render in prod).
# ALLOWED_ORIGINS=https://teachingassistant.vercel.app,https://my-domain.com

# Anthropic API key for the AI Studio generation endpoint. Optional — Studio
# is gated by the `ai_studio` feature flag (off by default), so leave this
# empty unless you've turned that flag on in the Dev console.
# Get one from https://console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Frontend (Next.js / Vercel) -------------------------------------------
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time and are PUBLIC. Never put a secret behind this prefix. (Firebase
# Web config is designed to be public — access is controlled by Firebase
# security rules and the backend's token verification, not by hiding these.)
#
# These were named VITE_FIREBASE_* before the Next.js migration. Rename them
# in the Vercel project settings when deploying this branch, or sign-in will
# fail with `auth/invalid-api-key`.
#
# Values come from Firebase console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — only needed if Firebase Analytics is enabled.
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Prefix for /api calls. Leave EMPTY in normal deployments — next.config.ts
# rewrites /api/* server-side, so the browser talks to its own origin and no
# CORS preflight is needed. Set it only to point a local frontend at a
# remote API. (Replaces the old VITE_API_URL.)
# NEXT_PUBLIC_API_URL=

# ---- Deploy-time only ------------------------------------------------------

# Where Next's /api/* rewrite proxies to. Defaults to the Render URL in
# production and localhost:$PORT in dev — override only for staging.
# API_PROXY_TARGET=https://murchid-api.onrender.com

# ---- Tooling ---------------------------------------------------------------

# 21st.dev component registry. Only needed by developers using the MCP server
# in .mcp.json; the app does not read it at runtime. Export it in your shell
# (Claude Code expands ${TWENTYFIRST_API_KEY} from the environment, not from
# this file) — e.g. add it to ~/.zshrc.
# TWENTYFIRST_API_KEY=21st_sk_...
