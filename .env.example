# Copy this file to .env for local dev. .env is gitignored.
#
# `npm run dev` starts BOTH processes (concurrently):
#   - the Express API  (backend/index.js, port 3001) — reads the vars below
#   - the Next.js app  (next dev, port 3000)         — reads NEXT_PUBLIC_* only
# Next rewrites /api/* to the Express port, so the browser stays same-origin.

# ---- Backend (Render in prod, Express locally) -----------------------------

# Supabase Postgres connection string. Used by:
#   - backend/lib/db.js   — every API route
#   - backend/db/init.js  — schema + seed (`npm run db:init`)
#
# Use the SUPAVISOR POOLER string (port 6543), not the direct one. The
# direct host db.<ref>.supabase.co resolves to IPv6 only, which Render
# cannot reach; the pooler is IPv4.
# Dashboard → Connect → Transaction pooler.
#
# Do NOT append sslmode=require. TLS is handled in backend/lib/db.js by
# pinning the Supabase root CA — and this pg version reads sslmode=require
# as verify-full, which then fails against the system trust store. Omitting
# it does not mean plaintext here; see backend/lib/supabaseCa.js.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Express port. Render sets this automatically; leave it at 3001 for local dev.
PORT=3001

# Where Next's /api/* rewrite proxies to in dev. Deliberately NOT derived from
# PORT: Next overwrites PORT with the port IT listens on, which turned the
# rewrite into a proxy loop back to the Next server. Only change this if the
# API runs somewhere other than localhost:3001.
API_PORT=3001

# Comma-separated list of allowed frontend origins for CORS. Leave empty to
# allow all origins (fine for dev; lock down on Render in prod).
# ALLOWED_ORIGINS=https://teachingassistant.vercel.app,https://my-domain.com

# Which Supabase project the API verifies access tokens against. The API
# fetches this project's public JWKS and checks token signatures locally —
# no service account, no shared JWT secret (a shared secret would let this
# process MINT tokens, not just verify them).
SUPABASE_URL=https://PROJECTREF.supabase.co

# Anthropic API key for the AI Studio generation endpoint. Optional — Studio
# is gated by the `ai_studio` feature flag (off by default), so leave this
# empty unless you've turned that flag on in the Dev console.
# Get one from https://console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini API key. An ALTERNATIVE to the Anthropic key for reading uploaded
# CVs and staff IDs (POST /api/onboarding/parse) — whichever is set is used,
# Gemini first. Free keys from https://aistudio.google.com/apikey work.
#
# ⚠️ On Google's FREE tier, submitted content may be used to improve their
# models. These uploads are teacher CVs and institution ID cards, so for
# production use a paid Google Cloud key (where it is not) or the Anthropic
# key instead. A free key is fine for local development with your own files.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # rolling alias; pin only if you must

# ---- Frontend (Next.js / Vercel) -------------------------------------------
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time and are PUBLIC. Never put a secret behind this prefix.
#
# The Supabase publishable key is public by design: it identifies the
# project and carries no privileges of its own. Access is controlled by
# Row Level Security and by the backend verifying the access token — not
# by hiding this value. The SECRET key (sb_secret_…) must never appear
# here; it belongs only in server-side env.
#
# Values come from the Supabase dashboard → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECTREF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Prefix for /api calls. Leave EMPTY in normal deployments — next.config.ts
# rewrites /api/* server-side, so the browser talks to its own origin and no
# CORS preflight is needed. Set it only to point a local frontend at a
# remote API. (Replaces the old VITE_API_URL.)
# NEXT_PUBLIC_API_URL=

# ---- Deploy-time only ------------------------------------------------------

# Where Next's /api/* rewrite proxies to. Defaults to the Render URL in
# production and localhost:$PORT in dev — override only for staging.
# API_PROXY_TARGET=https://murchid-api.onrender.com

# ---- Tooling ---------------------------------------------------------------

# 21st.dev component registry. Only needed by developers using the MCP server
# in .mcp.json; the app does not read it at runtime. Export it in your shell
# (Claude Code expands ${TWENTYFIRST_API_KEY} from the environment, not from
# this file) — e.g. add it to ~/.zshrc.
# TWENTYFIRST_API_KEY=21st_sk_...
