# Copy this file to .env and fill in real values. .env is gitignored.
#
# Neon Postgres connection string. Used by:
#   - vite.config.js   — the dev-only /api/* middleware
#   - db/init.js       — schema + seed (`npm run db:init`)
#
# Get one from https://console.neon.tech (free tier is enough).
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
