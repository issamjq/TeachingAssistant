# Copy this file to .env.local for the app, or .env for the migration
# scripts. Both are gitignored.
#
# There is no API server in this project. `npm run dev` starts Next and
# nothing else; the app reads and writes Supabase directly.

# ---- Migrations only (npm run db:tune / db:seed) ---------------------
#
# Not read by the app. Use the SUPAVISOR POOLER string (port 6543), not
# the direct one: db.<ref>.supabase.co resolves to IPv6 only.
# Dashboard → Connect → Transaction pooler.
#
# Do NOT append sslmode=require. TLS is handled in db/client.js by pinning
# the Supabase root CA — this pg version reads sslmode=require as
# verify-full, which then fails against the system trust store.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---- Frontend (Next.js / Vercel) -------------------------------------------
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time and are PUBLIC. Never put a secret behind this prefix.
#
# The Supabase publishable key is public by design: it identifies the
# project and carries no privileges of its own. Access is controlled by
# Row Level Security and by the backend verifying the access token — not
# by hiding this value. The SECRET key (sb_secret_…) must never appear
# here; it belongs only in server-side env.
#
# Values come from the Supabase dashboard → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECTREF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Prefix for /api calls. Leave EMPTY in normal deployments — next.config.ts
# rewrites /api/* server-side, so the browser talks to its own origin and no
# CORS preflight is needed. Set it only to point a local frontend at a
# remote API. (Replaces the old VITE_API_URL.)
# NEXT_PUBLIC_API_URL=

# ---- Deploy-time only ------------------------------------------------------

# Where Next's /api/* rewrite proxies to. Defaults to the Render URL in
# production and localhost:$PORT in dev — override only for staging.
# API_PROXY_TARGET=https://murchid-api.onrender.com

# ---- Tooling ---------------------------------------------------------------

# 21st.dev component registry. Only needed by developers using the MCP server
# in .mcp.json; the app does not read it at runtime. Export it in your shell
# (Claude Code expands ${TWENTYFIRST_API_KEY} from the environment, not from
# this file) — e.g. add it to ~/.zshrc.
# TWENTYFIRST_API_KEY=21st_sk_...

# ---- The separate backend --------------------------------------------
#
# Where the endpoints that need a secret are served from — AI generation,
# CV parsing, the auth bootstrap, the privileged consoles. See
# todo/backend-requirements.md.
#
# Leave EMPTY and those paths 404 as themselves, which is the truth. Set
# it and Next rewrites /api/* there server-side, so the browser stays
# same-origin and there is no CORS preflight.
# API_PROXY_TARGET=https://your-backend.example.com

# ---- Demo accounts (npm run db:demo) ---------------------------------
#
# Two accounts for looking at the product with your own eyes: one filled
# with a term's worth of plausible data, one onboarded and completely
# empty. Neither is needed to run the app.
#
# The filled account must already exist — sign it up through the app
# once, then db:demo writes a roster, a timetable, marks, attendance and
# a nine-week library onto it. Re-running replaces that data rather than
# doubling it, and it refuses to touch any account but this one.
# TEST_ACCOUNT_EMAIL=test.teacher@example.com
# TEST_ACCOUNT_PASSWORD=

# The empty one is CREATED by the seed, straight in auth.users. Change
# the password before using this anywhere that is not your machine.
# DEMO_EMPTY_EMAIL=test.empty@example.com
# DEMO_EMPTY_PASSWORD=
